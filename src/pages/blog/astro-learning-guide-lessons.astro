---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const SERIES_KEY = 'astro-learning-guide';

const getLessonNumber = (id: string) => {
  const match = id.match(/astro-learning-guide\/lesson-(\d+)-/);
  return match ? Number(match[1]) : Number.MAX_SAFE_INTEGER;
};

const lessons = (await getCollection('blog'))
  .filter((post) => post.data.series === SERIES_KEY && post.data.draft !== true)
  .sort((a, b) => {
    const lessonDelta = getLessonNumber(a.id) - getLessonNumber(b.id);
    if (lessonDelta !== 0) {
      return lessonDelta;
    }
    return a.data.pubDate.valueOf() - b.data.pubDate.valueOf();
  });

const pageTitle = 'Astro Learning Guide';
const pageDescription =
  'A complete Astro learning path from foundations to deployment, organized as a step-by-step series.';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead description={pageDescription} title={`${pageTitle} | ${SITE_TITLE}`} />
    <style>
      main {
        width: 860px;
      }
      .hero {
        margin-bottom: 2rem;
      }
      .hero h1 {
        margin-bottom: 0.5rem;
      }
      .hero p {
        margin: 0;
        color: rgb(var(--gray));
      }
      .blob-link {
        margin-top: 0.9rem;
      }
      .blob-link a {
        text-decoration: none;
        font-weight: 600;
      }
      .blob-link a:hover {
        text-decoration: underline;
      }
      .list {
        display: grid;
        gap: 0.9rem;
      }
      .card {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1rem;
        padding: 1rem 1.1rem;
        border: 1px solid rgb(var(--border));
        border-radius: 14px;
        background: rgb(var(--surface));
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }
      .card:hover {
        transform: translateY(-2px);
        box-shadow: var(--box-shadow);
      }
      .step {
        height: 2rem;
        width: 2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        border-radius: 999px;
        background: var(--accent);
        color: white;
      }
      .meta {
        margin: 0 0 0.35rem 0;
        color: rgb(var(--gray));
        font-size: 0.9rem;
      }
      .title {
        margin: 0 0 0.35rem 0;
        line-height: 1.25;
      }
      .title a {
        text-decoration: none;
      }
      .title a:hover {
        text-decoration: underline;
      }
      .description {
        margin: 0;
      }
      .empty {
        padding: 1rem;
        border: 1px dashed rgb(var(--border));
        border-radius: 14px;
        background: rgb(var(--surface));
      }
      @media (max-width: 720px) {
        .card {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <h1>{pageTitle}</h1>
        <p>{pageDescription}</p>
        <p class="blob-link">
          <a href="/blog/astro-learning-guide/lesson-00-complete-guide/">
            Read the full multi-section blob version
          </a>
        </p>
      </section>

      {
        lessons.length === 0 ? (
          <section class="empty">
            No lessons found yet for this series. Add posts with
            <code>series: "astro-learning-guide"</code> in frontmatter.
          </section>
        ) : (
          <section class="list">
            {lessons.map((post, index) => (
              <article class="card">
                <div class="step">{index + 1}</div>
                <div>
                  <p class="meta">
                    Lesson {index + 1} · <FormattedDate date={post.data.pubDate} />
                  </p>
                  <h2 class="title">
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h2>
                  <p class="description">{post.data.description}</p>
                </div>
              </article>
            ))}
          </section>
        )
      }
    </main>
    <Footer />
  </body>
</html>
