---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const toPostSlug = (id: string) => (id.endsWith('/index') ? id.slice(0, -'/index'.length) : id);
const isFolderIndexEntry = (post: (typeof posts)[number]) =>
  post.id.endsWith('/index') || post.filePath?.replace(/\\/g, '/').endsWith('/index.mdx');

const visiblePosts = posts.filter(isFolderIndexEntry);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead description={SITE_DESCRIPTION} title={SITE_TITLE} />
    <style>
      main {
        width: 980px;
      }
      ul {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
      }
      ul li {
        width: 100%;
      }
      ul li * {
        text-decoration: none;
        transition: 0.2s ease;
      }
      ul li:first-child {
        grid-column: 1 / -1;
      }
      ul li:first-child :global(img) {
        width: 100%;
      }
      ul li:first-child .title {
        font-size: 2.1rem;
      }
      ul li:first-child .card {
        padding: 1.4rem;
      }
      ul li :global(img) {
        margin-bottom: 0.8rem;
        border-radius: 12px;
        border: 1px solid rgb(var(--border));
      }
      ul li a {
        display: block;
      }
      .card {
        padding: 1rem;
        border: 1px solid rgb(var(--border));
        border-radius: 14px;
        background: rgb(var(--surface));
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.03);
      }
      .meta {
        margin: 0;
        color: rgb(var(--gray));
        font-size: 0.93rem;
        font-weight: 600;
      }
      .title {
        margin: 0.25rem 0 0.45rem 0;
        color: rgb(var(--text));
        line-height: 1.2;
      }
      .description {
        margin: 0;
        color: rgb(var(--text-soft));
      }
      ul li a:hover h4 {
        color: var(--accent);
      }
      ul li a:hover .card {
        box-shadow: var(--box-shadow);
        transform: translateY(-2px);
      }
      @media (max-width: 720px) {
        ul {
          grid-template-columns: 1fr;
          gap: 0.9rem;
        }
        ul li:first-child {
          grid-column: auto;
        }
        ul li:first-child .title {
          font-size: 1.45em;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section>
        <ul>
          {
            visiblePosts.map((post) => (
              <li>
                <a href={`/blog/${toPostSlug(post.id)}/`}>
                  <article class="card">
                    {post.data.heroImage && (
                      <Image alt="" height={360} src={post.data.heroImage} width={720} />
                    )}
                    <p class="meta">
                      <FormattedDate date={post.data.pubDate} />
                    </p>
                    <h4 class="title">{post.data.title}</h4>
                    <p class="description">{post.data.description}</p>
                  </article>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
