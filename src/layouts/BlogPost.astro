---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  headings?: MarkdownHeading[];
  entryId?: string;
  entryFilePath?: string;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  headings = [],
  entryId = '',
  entryFilePath = '',
} = Astro.props;

const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const normalizedPath = entryFilePath.replace(/\\/g, '/');
const isFolderBlobPost = entryId.endsWith('/index') || normalizedPath.endsWith('/index.mdx');
const showFloatingToc = isFolderBlobPost || tocHeadings.length >= 6;
---

<html lang="en">
  <head>
    <BaseHead description={description} title={title} />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
      }
      .hero-image {
        width: 100%;
      }
      .hero-image :global(img) {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }
      .content-shell {
        display: grid;
        grid-template-columns: minmax(0, 76ch);
        justify-content: center;
        gap: 2rem;
      }
      .content-shell.has-toc .prose {
        margin: 0;
        max-width: 100%;
        width: 100%;
      }
      .prose {
        width: min(100%, 76ch);
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: rgb(var(--text));
        font-weight: 500;
        text-rendering: optimizeLegibility;
      }
      .toc {
        display: block;
        padding: 0;
        border: 1px solid rgb(var(--border));
        border-radius: 16px;
        background: linear-gradient(180deg, rgb(var(--surface)), rgba(var(--surface), 0.88));
        box-shadow: var(--box-shadow);
        overflow: clip;
      }
      .toc-header {
        padding: 0.95rem 1rem 0.4rem;
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-weight: 700;
        color: rgb(var(--gray));
        cursor: pointer;
        list-style: none;
      }
      .toc-header::-webkit-details-marker {
        display: none;
      }
      .toc-body {
        padding: 0.25rem 0.75rem 0.85rem;
        display: grid;
        gap: 0.35rem;
      }
      .toc-body :global(.toc-section) {
        display: grid;
        gap: 0.2rem;
      }
      .toc :global(.toc-group) {
        border-radius: 12px;
        border: 1px solid transparent;
        overflow: clip;
      }
      .toc :global(.toc-group.is-active) {
        border-color: rgba(138, 92, 246, 0.22);
        background: rgba(138, 92, 246, 0.06);
      }
      .toc :global(.toc-group summary) {
        list-style: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.8rem 0.9rem;
        cursor: pointer;
        user-select: none;
        font-weight: 700;
        color: rgb(var(--text));
        border-radius: 10px;
        transition:
          background-color 0.18s ease,
          color 0.18s ease,
          transform 0.18s ease;
      }
      .toc :global(.toc-group summary::-webkit-details-marker) {
        display: none;
      }
      .toc :global(.toc-group summary::after) {
        content: '▾';
        font-size: 0.9rem;
        color: rgb(var(--gray));
        transition: transform 0.18s ease;
      }
      .toc :global(.toc-group[open] summary::after) {
        transform: rotate(180deg);
      }
      .toc :global(.toc-group summary:hover) {
        background: rgba(138, 92, 246, 0.08);
        transform: translateY(-1px);
      }
      .toc :global(.toc-group summary.active) {
        color: rgb(var(--black));
        background: rgba(138, 92, 246, 0.12);
      }
      .toc :global(.toc-summary-text) {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      .toc :global(.toc-jump) {
        flex: none;
        text-decoration: none;
        color: rgb(var(--gray));
        font-size: 0.8rem;
        padding: 0.1rem 0.35rem;
        border-radius: 999px;
        border: 1px solid transparent;
      }
      .toc :global(.toc-jump:hover) {
        color: var(--accent);
        border-color: rgba(138, 92, 246, 0.18);
        background: rgba(138, 92, 246, 0.08);
      }
      .toc :global(ul) {
        margin: 0.2rem 0 0;
        padding: 0 0 0.55rem 0.4rem;
        list-style: none;
        display: grid;
        gap: 0.45rem;
      }
      .toc :global(li) {
        line-height: 1.35;
      }
      .toc :global(li.depth-3) {
        padding-left: 0.55rem;
      }
      .toc :global(a) {
        color: rgb(var(--text-soft));
        text-decoration: none;
        display: inline-block;
        border-left: 2px solid transparent;
        padding-left: 0.55rem;
        border-radius: 999px;
        transition:
          background-color 0.18s ease,
          color 0.18s ease,
          border-color 0.18s ease;
      }
      .toc :global(a:hover) {
        color: var(--accent);
        background: rgba(138, 92, 246, 0.08);
      }
      .toc :global(a.active) {
        color: rgb(var(--text));
        font-weight: 700;
        border-left-color: var(--accent);
        background: linear-gradient(90deg, rgba(138, 92, 246, 0.12), transparent);
        border-radius: 999px;
      }
      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1;
      }
      .title h1 {
        margin: 0 0 0.5em;
      }
      .date {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
      }
      .last-updated-on {
        font-style: italic;
      }
      @media (min-width: 1120px) {
        .content-shell.has-toc {
          grid-template-columns: minmax(0, 76ch) minmax(260px, 300px);
          align-items: start;
        }
        .toc {
          position: sticky;
          top: 6.5rem;
          max-height: calc(100vh - 7rem);
          overflow: auto;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          {heroImage && <Image alt="" height={510} src={heroImage} width={1020} />}
        </div>
        <div class:list={['content-shell', { 'has-toc': showFloatingToc }]}>
          <div class="prose">
            <div class="title">
              <div class="date">
                <FormattedDate date={pubDate} />
                {
                  updatedDate && (
                    <div class="last-updated-on">
                      Last updated on <FormattedDate date={updatedDate} />
                    </div>
                  )
                }
              </div>
              <h1>{title}</h1>
              <hr />
            </div>
            <slot />
          </div>
          {
            showFloatingToc && (
              <details aria-label="Section index" class="toc">
                <summary class="toc-header">On this page</summary>
                <div class="toc-body" />
              </details>
            )
          }
        </div>
      </article>
    </main>
    <Footer />
    <script is:inline src="/scripts/toc.js"></script>
  </body>
</html>
