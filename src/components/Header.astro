---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
  <nav>
    <h2 class="brand"><a href="/">{SITE_TITLE}</a></h2>
    <div class="internal-links">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
      <HeaderLink href="/blog/astro-learning-guide/">Learning Guide</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
    </div>
    <div class="actions">
      <button aria-label="Toggle dark mode" class="theme-toggle" data-theme-toggle type="button">
        <span aria-hidden="true">◐</span>
      </button>
      <a
        href="https://github.com/scriptautomation123/scriptautomation123.github.io"
        target="_blank"
      >
        <span class="sr-only">View repository on GitHub</span>
        <svg aria-hidden="true" height="24" viewBox="0 0 16 16" width="24"
          ><path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            fill="currentColor"></path></svg
        >
      </a>
    </div>
  </nav>
</header>

<script is:inline src="/scripts/theme-toggle.js"></script>
<style>
  header {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(8px);
    background: color-mix(in srgb, rgb(var(--surface)) 86%, transparent);
    border-bottom: 1px solid rgb(var(--border));
  }

  .brand {
    margin: 0;
    font-size: 1rem;
  }

  .brand a {
    padding: 0;
    font-weight: 700;
    letter-spacing: 0;
    text-decoration: none;
    color: rgb(var(--text));
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0.65rem 1rem;
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .internal-links :global(a) {
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    color: rgb(var(--text-soft));
    text-decoration: none;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .internal-links :global(a:hover),
  .internal-links :global(a.active) {
    color: rgb(var(--text));
    background-color: rgb(var(--surface-muted));
  }

  .actions,
  .actions a {
    display: flex;
    align-items: center;
    color: rgb(var(--text-soft));
  }

  .actions {
    gap: 0.55rem;
  }

  .actions a:hover {
    color: rgb(var(--text));
  }

  @media (max-width: 720px) {
    nav {
      flex-wrap: wrap;
      justify-content: center;
    }

    .brand {
      width: 100%;
      text-align: center;
    }

    .internal-links {
      justify-content: center;
      flex-wrap: wrap;
    }

    .actions {
      display: none;
    }
  }
</style>
