{
  "version": "0.2.0",
  "configurations": [
    {
      "command": "./node_modules/.bin/astro dev",
      "name": "Dev server",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "command": "./node_modules/.bin/astro build",
      "name": "Build",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "command": "./node_modules/.bin/astro preview",
      "name": "Preview (after build)",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "command": "./node_modules/.bin/astro check",
      "name": "Type check",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "command": "npm run fix",
      "name": "Format + Lint",
      "request": "launch",
      "type": "node-terminal"
    },
    {
      "command": "npm run validate",
      "name": "Validate (check + lint + build)",
      "request": "launch",
      "type": "node-terminal"
    }
  ]
}
