{
  "name": "scriptautomation123.github.io",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "npm run lint:markdown && npm run lint:eslint",
    "lint:markdown": "markdownlint-cli2 \"README.md\" \"docs/**/*.{md,mdx}\" \"src/content/**/*.{md,mdx}\"",
    "lint:eslint": "eslint . 2>&1 | grep -E 'error|✖' || true",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "prettier --write . && eslint . 2>&1 | grep -E 'error|✖' || true",
    "validate": "npm run check && npm run lint && npm run build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "lychee": "^0.2.7",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.4",
    "sharp": "^0.35.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
